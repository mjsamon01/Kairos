rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace ADMIN_UID_HERE with your own user ID (shown on the "Almost there" screen).
    function isAdmin() {
      return request.auth != null && request.auth.uid == '';
    }
    function isApproved() {
      return request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.status == 'approved'
      );
    }

    // Sign-up requests: people can create their own "pending" request. Only the admin can change it.
    match /profiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Each person's planner data: only that person, and only once approved.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && isApproved();
    }
  }
}
